# Enterprise AI Platform Staging Environment Configuration Template
# Copy to .env.staging for staging runtime deployment (Do NOT commit real secrets)

ENVIRONMENT=STAGING
DEBUG=false
APP_NAME=Enterprise-AI-Platform
APP_VERSION=1.0.0
DEPLOYMENT_VERSION=5.60A
REGION=us-east-1

# Infrastructure Database & Cache Configuration (Internal Compose Network Targets)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/llm_engine
REDIS_URL=redis://redis:6379/0

# Feature Toggles
CACHE_ENABLED=true
MESSAGING_ENABLED=true
OBSERVABILITY_ENABLED=true

# Security Credentials (Must be injected securely in staging environment)
JWT_SECRET=STAGING_SECURE_JWT_SECRET_CANARY_5_60A
SECRET_KEY=STAGING_SECURE_PLATFORM_SECRET_CANARY_5_60A
CANARY_DB_PASSWORD_5_60A=CANARY_DB_PASSWORD_STAGING_5_60A
CANARY_JWT_SECRET_5_60A=CANARY_JWT_SECRET_STAGING_5_60A
CANARY_API_KEY_5_60A=CANARY_API_KEY_STAGING_5_60A

# Timeout Limits (Seconds)
STARTUP_TIMEOUT=30
SHUTDOWN_TIMEOUT=30
