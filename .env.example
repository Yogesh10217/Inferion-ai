# ==============================================================================
# LLM Inference Engine Environment Configuration
# ==============================================================================

# Application Metadata & Core Settings
APP_NAME="LLM Inference Engine"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/v1"
LOG_LEVEL="INFO"

# Server Host & Network Binding
HOST="0.0.0.0"
PORT=8002

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Provider Integrations
# OpenAI API Key (Leave empty to use simulated provider responses)
OPENAI_API_KEY=""

# Ollama Endpoint (Default local instance or container hostname)
OLLAMA_BASE_URL="http://localhost:11434"

# Routing & Default Selection Placeholders
DEFAULT_PROVIDER="openai"
DEFAULT_MODEL="gpt-4o-mini"
