# Inferion AI — Environment Configuration Template
# Copy to .env for local development (Do NOT commit real secrets to version control)

APP_NAME=Inferion AI
APP_VERSION=0.9.0
DEPLOYMENT_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Region & Instance Metadata
REGION=us-east-1
INSTANCE_ID=instance-node-01

# Infrastructure Database & Cache (Sanitized Placeholders)
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/enterprise_ai_db
REDIS_URL=redis://localhost:6379/0

# Feature Toggles
CACHE_ENABLED=true
MESSAGING_ENABLED=true
OBSERVABILITY_ENABLED=true

# Security Credentials (Placeholders Only - Never use defaults in Production)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_HERE
SECRET_KEY=YOUR_SECURE_PLATFORM_SECRET_KEY_HERE
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Timeout Limits (Seconds)
STARTUP_TIMEOUT=30
SHUTDOWN_TIMEOUT=30
