# Enterprise AI Platform Production Simulation Configuration
ENVIRONMENT=PRODUCTION
DEPLOYMENT_MODE=SIMULATION
DEBUG=false
APP_NAME=Enterprise-AI-Platform
APP_VERSION=1.0.0
DEPLOYMENT_VERSION=5.62
REGION=us-east-1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@simulation-db:5432/llm_engine_sim
REDIS_URL=redis://simulation-redis:6379/0

CACHE_ENABLED=true
MESSAGING_ENABLED=true
OBSERVABILITY_ENABLED=true

JWT_SECRET=PROD_SIMULATION_SECURE_JWT_SECRET_CANARY_5_62
SECRET_KEY=PROD_SIMULATION_SECURE_PLATFORM_SECRET_CANARY_5_62
CANARY_DB_PASSWORD_5_62=CANARY_DB_PASSWORD_PROD_SIMULATION_5_62
CANARY_JWT_SECRET_5_62=CANARY_JWT_SECRET_PROD_SIMULATION_5_62
CANARY_API_KEY_5_62=CANARY_API_KEY_PROD_SIMULATION_5_62

STARTUP_TIMEOUT=30
SHUTDOWN_TIMEOUT=30
